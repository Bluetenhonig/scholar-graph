# Copy to .env and edit. Every value below is a default; nothing here is required
# to run in replay mode.

# --- LLM ---------------------------------------------------------------------
# replay = use recorded cassettes (offline, free, deterministic)
# record = call the API and save cassettes
# live   = call the API, save nothing
SCHOLAR_GRAPH_LLM_MODE=replay
# SCHOLAR_GRAPH_ANTHROPIC_API_KEY=sk-ant-...

SCHOLAR_GRAPH_REASONING_MODEL=claude-opus-5
SCHOLAR_GRAPH_WORKER_MODEL=claude-haiku-4-5
SCHOLAR_GRAPH_MAX_TOKENS=16000

# --- Budgets -----------------------------------------------------------------
SCHOLAR_GRAPH_MAX_USD_PER_RUN=0.50
SCHOLAR_GRAPH_MAX_SEARCH_ROUNDS=3
SCHOLAR_GRAPH_MAX_DOCUMENTS=24

# --- Human in the loop -------------------------------------------------------
SCHOLAR_GRAPH_REQUIRE_APPROVAL_OVER_USD=0.25
SCHOLAR_GRAPH_ENABLE_REVIEW_PANEL=true

# --- Tools -------------------------------------------------------------------
# OpenAlex asks for a contact address to put callers in its polite pool.
SCHOLAR_GRAPH_OPENALEX_MAILTO=you@example.com
SCHOLAR_GRAPH_HTTP_TIMEOUT_SECONDS=20
SCHOLAR_GRAPH_HTTP_MAX_ATTEMPTS=3

# --- Observability -----------------------------------------------------------
SCHOLAR_GRAPH_LOG_LEVEL=INFO
SCHOLAR_GRAPH_LOG_FORMAT=console
